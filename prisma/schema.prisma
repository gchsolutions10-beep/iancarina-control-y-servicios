  permisos_extra                                                       app_usuario_permisos[]   @relation("app_usuario_permisos_id_usuario")
  app_usuario_roles                                                    app_usuario_roles[]
  creador                                                              app_usuarios?            @relation("app_usuariosToapp_usuarios", fields: [creado_por], references: [id_usuario], onDelete: NoAction, onUpdate: NoAction)
  creados                                                              app_usuarios[]           @relation("app_usuariosToapp_usuarios")
  archivos                                                             archivos[]
  beneficiarios                                                        beneficiarios[]
  calculos                                                             calculos[]
  documentos                                                           documentos[]
  endosos                                                              endosos[]
  fusiones_personas_fusiones_personas_creado_porToapp_usuarios         fusiones_personas[]      @relation("fusiones_personas_creado_porToapp_usuarios")
  fusiones_personas_fusiones_personas_revertida_porToapp_usuarios      fusiones_personas[]      @relation("fusiones_personas_revertida_porToapp_usuarios")
  imputaciones                                                         imputaciones[]
  inclusion_coberturas_inclusion_coberturas_ajustado_porToapp_usuarios inclusion_coberturas[]   @relation("inclusion_coberturas_ajustado_porToapp_usuarios")
  inclusion_coberturas_inclusion_coberturas_creado_porToapp_usuarios   inclusion_coberturas[]   @relation("inclusion_coberturas_creado_porToapp_usuarios")
  inclusiones                                                          inclusiones[]
  limites                                                              limites[]
  obligacion_movimientos                                               obligacion_movimientos[]
  obligaciones                                                         obligaciones[]
  pagos_pagos_anulado_porToapp_usuarios                                pagos[]                  @relation("pagos_anulado_porToapp_usuarios")
  pagos_pagos_creado_porToapp_usuarios                                 pagos[]                  @relation("pagos_creado_porToapp_usuarios")
  partes_partes_actualizado_porToapp_usuarios                          partes[]                 @relation("partes_actualizado_porToapp_usuarios")
  partes_partes_creado_porToapp_usuarios                               partes[]                 @relation("partes_creado_porToapp_usuarios")
  periodo_partes                                                       periodo_partes[]
  periodo_tarifas                                                      periodo_tarifas[]
  personas_distintas                                                   personas_distintas[]
  poliza_periodos_poliza_periodos_confirmado_porToapp_usuarios         poliza_periodos[]        @relation("poliza_periodos_confirmado_porToapp_usuarios")
  poliza_periodos_poliza_periodos_creado_porToapp_usuarios             poliza_periodos[]        @relation("poliza_periodos_creado_porToapp_usuarios")
  polizas_polizas_actualizado_porToapp_usuarios                        polizas[]                @relation("polizas_actualizado_porToapp_usuarios")
  polizas_polizas_creado_porToapp_usuarios                             polizas[]                @relation("polizas_creado_porToapp_usuarios")
  propiedades_propiedades_actualizado_porToapp_usuarios                propiedades[]            @relation("propiedades_actualizado_porToapp_usuarios")
  propiedades_propiedades_creado_porToapp_usuarios                     propiedades[]            @relation("propiedades_creado_porToapp_usuarios")
