  personas_distintas_personas_distintas_empresa_id_bTopartes     personas_distintas[]   @relation("personas_distintas_empresa_id_bTopartes")
  polizas                                                        polizas[]
  reglas_calculo                                                 reglas_calculo[]
  siniestro_afectados                                            siniestro_afectados[]
