/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model archivos {
  id           String        @id @db.Uuid
  empresa      String        @db.VarChar(30)
  almacen      String        @db.VarChar(10)
  clave        String
  nombre       String        @db.VarChar(255)
  tipo_mime    String        @db.VarChar(120)
  tamano       BigInt
  sha256       String        @db.Char(64)
  es_imagen    Boolean
  subido_por   Int
  subido_en    DateTime      @default(now()) @db.Timestamptz(6)
  app_empresas app_empresas  @relation(fields: [empresa], references: [codigo], onDelete: NoAction)
  app_usuarios app_usuarios  @relation(fields: [subido_por], references: [id_usuario], onDelete: NoAction, onUpdate: NoAction)
  documentos   documentos[]
  partes       partes[]
  propiedades  propiedades[]
  vehiculos    vehiculos[]

  @@unique([empresa, id])
  @@schema("cys")
}

model catalogo_valores {
  id     Int     @id @default(autoincrement())
  lista  String  @db.VarChar(40)
  nombre String  @db.VarChar(120)
  orden  Int     @default(0)
  activo Boolean @default(true)

  @@unique([lista, nombre])
  @@schema("cys")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model documentos {
  id              BigInt       @id @default(autoincrement())
  empresa         String       @db.VarChar(30)
  id_archivo      String       @db.Uuid
  tipo_documento  String       @db.VarChar(120)
  descripcion     String?
  fecha_documento DateTime?    @db.Date
  confidencial    Boolean      @default(false)
  id_parte        BigInt?
  id_vehiculo     BigInt?
  id_propiedad    BigInt?
  retirado        Boolean      @default(false)
  creado_en       DateTime     @default(now()) @db.Timestamptz(6)
  creado_por      Int
  id_poliza       BigInt?
  id_siniestro    BigInt?
  app_usuarios    app_usuarios @relation(fields: [creado_por], references: [id_usuario], onDelete: NoAction, onUpdate: NoAction)
  archivos        archivos     @relation(fields: [empresa, id_archivo], references: [empresa, id], onDelete: NoAction, onUpdate: NoAction)
  partes          partes?      @relation(fields: [empresa, id_parte], references: [empresa, id], onDelete: NoAction, onUpdate: NoAction)
  propiedades     propiedades? @relation(fields: [empresa, id_propiedad], references: [empresa, id], onDelete: NoAction, onUpdate: NoAction)
  vehiculos       vehiculos?   @relation(fields: [empresa, id_vehiculo], references: [empresa, id], onDelete: NoAction, onUpdate: NoAction)
  polizas         polizas?     @relation(fields: [empresa, id_poliza], references: [empresa, id], onDelete: NoAction, onUpdate: NoAction, map: "documentos_poliza")
  siniestros      siniestros?  @relation(fields: [empresa, id_siniestro], references: [empresa, id], onDelete: NoAction, onUpdate: NoAction, map: "documentos_siniestro")

  @@unique([empresa, id])
  @@index([empresa, id_parte], map: "documentos_parte", where: raw("(id_parte IS NOT NULL)"))
  @@index([empresa, id_propiedad], map: "documentos_propiedad", where: raw("(id_propiedad IS NOT NULL)"))
  @@index([empresa, id_vehiculo], map: "documentos_vehiculo", where: raw("(id_vehiculo IS NOT NULL)"))
  @@index([empresa, id_poliza], map: "documentos_poliza_idx", where: raw("(id_poliza IS NOT NULL)"))
  @@index([empresa, id_siniestro], map: "documentos_siniestro_idx", where: raw("(id_siniestro IS NOT NULL)"))
  @@schema("cys")
}

model marcas {
  id      Int       @id @default(autoincrement())
  nombre  String    @unique @db.VarChar(80)
  activo  Boolean   @default(true)
  modelos modelos[]

  @@schema("cys")
}

model modelos {
  id        Int         @id @default(autoincrement())
  id_marca  Int
  nombre    String      @db.VarChar(80)
  activo    Boolean     @default(true)
  marcas    marcas      @relation(fields: [id_marca], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vehiculos vehiculos[]

  @@unique([id_marca, nombre])
  @@schema("cys")
}

