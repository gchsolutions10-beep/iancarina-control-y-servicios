# =============================================================================
# SERVIDOR DE LA EMPRESA (instalación interna). Guía: docs/INSTALACION-SERVIDOR.md
# Copie este archivo como «.env» en la carpeta del sistema y complete cada valor.
# El .env tiene claves: no lo envíe por correo ni lo suba a GitHub.
# =============================================================================

# --- Base de datos (paso 3 de la guía) ----------------------------------------
# postgresql://USUARIO:CLAVE@SERVIDOR:PUERTO/BASE
# Si PostgreSQL está en el mismo servidor, SERVIDOR = localhost.
# Si la clave tiene símbolos (@ : / # ?), cámbielos: @ → %40, : → %3A, / → %2F, # → %23, ? → %3F
DATABASE_URL="postgresql://seguros_app:CLAVE-DE-LA-BASE@localhost:5432/seguros"
# Déjela vacía: se usa la misma de arriba.
DATABASE_URL_MIGRACIONES=""

# --- Sesión -------------------------------------------------------------------
# Texto aleatorio. Genérelo con:  npm run secreto   y péguelo aquí.
SESSION_SECRET="pega-aqui-el-resultado-de-npm-run-secreto"
# Horas que dura una sesión abierta.
SESSION_HORAS=12
# false si se entra con http:// (lo normal dentro de la red). true solo con certificado https://.
SESSION_COOKIE_SECURE=false
ZONA_HORARIA="America/Caracas"

# --- Primer administrador -------------------------------------------------------
# Se crea al ejecutar «npm run instalar» si no existe. Después del primer ingreso puede borrar la clave.
ADMIN_INICIAL_USUARIO="admin"
ADMIN_INICIAL_CLAVE="Una-Clave-Larga-2026"

# --- Documentos y fotos (paso 4 de la guía) -------------------------------------
# Carpeta del servidor donde se guardan. Ruta completa; en Windows con barras normales o dobles.
ALMACEN=carpeta
ARCHIVOS_RUTA_BASE="D:/SegurosArchivos"

# --- No cambiar ---------------------------------------------------------------
PREPARAR_DEMO=false
MODO_MANTENIMIENTO=false
