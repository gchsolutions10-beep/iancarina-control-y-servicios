# =============================================================================
# Copia este archivo como .env y completa los valores. Nunca subas .env al repositorio.
# =============================================================================

# --- Base de datos -----------------------------------------------------------
# DEMO (Vercel + Neon): cadena "pooled" de Neon (host con -pooler).
# PRODUCCIÓN (intranet): postgresql://usuario_web:clave@servidor:5432/seguros
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/seguros"
# Opcional: cadena directa (sin -pooler) para migraciones. Si falta, se usa DATABASE_URL.
DATABASE_URL_MIGRACIONES=""

# --- Sesión ------------------------------------------------------------------
# Mínimo 32 caracteres. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio-de-48-bytes"
SESSION_HORAS=12
# true en Vercel (HTTPS). En la intranet, true solo si el servidor tiene HTTPS.
SESSION_COOKIE_SECURE=false
ZONA_HORARIA="America/Caracas"

# --- Despliegue --------------------------------------------------------------
# true SOLO en la demo: carga empresas de prueba marcadas «DEMO».
PREPARAR_DEMO=false
# Primer administrador: se crea en el despliegue si no existe. Bórralas después del primer ingreso.
ADMIN_INICIAL_USUARIO=""
ADMIN_INICIAL_CLAVE=""

# --- Mantenimiento -------------------------------------------------------------
MODO_MANTENIMIENTO=false
