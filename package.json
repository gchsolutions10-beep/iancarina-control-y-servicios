{
  "name": "iancarina-control-y-servicios",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "tsx scripts/vercel-build.ts && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "prisma validate && next typegen && tsc --noEmit",
    "db:migrar": "tsx scripts/migrar.ts",
    "db:generar": "prisma generate",
    "db:introspeccion": "prisma db pull && tsx scripts/ajustar-prisma.ts",
    "usuario:soporte": "tsx scripts/usuario-soporte.ts",
    "postinstall": "prisma generate",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:bd": "node --import tsx --test --test-concurrency=1 tests/bd/*.test.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@vercel/blob": "^2.8.2",
    "bcryptjs": "^3.0.3",
    "decimal.js": "^10.6.0",
    "geist": "^1.7.2",
    "jose": "^6.2.12",
    "lucide-react": "^1.52.0",
    "next": "16.4.0",
    "pg": "^8.23.1",
    "prisma": "^7.10.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
